# Пример конфигурации. Скопируйте в .env и заполните значения.
# Сам файл .env в Git не попадает (см. .gitignore).

# --- Основное ---
NODE_ENV=production
PORT=3001
# В production слушаем только localhost: внешний доступ — через Nginx.
HOST=127.0.0.1

# --- Секреты ---
# Обязательно в production. Сгенерировать: openssl rand -hex 32
SESSION_SECRET=
SESSION_COOKIE_NAME=infoteh.sid
SESSION_TIMEOUT_MINUTES=480

# --- Пути (относительно каталога проекта, если не указан абсолютный) ---
DATABASE_PATH=infoteh.db
UPLOADS_PATH=uploads
BACKUP_PATH=backups
LOG_PATH=logs

# --- Прокси и cookie ---
# 1 — если приложение за Nginx (доверяем X-Forwarded-*)
TRUST_PROXY=1
# 1 — cookie только по HTTPS (обязательно в production за Nginx)
COOKIE_SECURE=1
# 1 — включить HSTS только после проверки HTTPS
ENABLE_HSTS=0
# Разрешённые источники через запятую (для CORS); пусто — CORS выключен
TRUSTED_ORIGINS=

# --- Ограничения ---
MAX_UPLOAD_MB=20
BACKUP_KEEP=14
NOTIFICATIONS_INTERVAL_MINUTES=60

# --- Демонстрационные учётные записи ---
# 0 — вход по демо-учёткам (ADM002/SM002/M002/PTO01) запрещён в production
ALLOW_DEMO_ACCOUNTS=0
# Пароли демо-учёток при первичном наполнении (только локально/демо)
SEED_PTO_PASSWORD=
SEED_ADMIN_PASSWORD=

# --- ИИ (по умолчанию выключен; подключение — отдельное решение) ---
AI_ENABLED=0
AI_PROVIDER=none
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
